[Unit]
Description=LAPNet FortiADC Load Balancer Live Syslog Ingestion & Reject Monitor
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/LAPNet/Fraud-monitor
Environment=PYTHONPATH=/root/LAPNet/Fraud-monitor
Environment=POSTGRES_HOST=127.0.0.1
Environment=POSTGRES_PORT=5432
Environment=POSTGRES_USER=lev
Environment=POSTGRES_PASSWORD=LEV@2026
Environment=POSTGRES_DB=lapnet_fraud_db
Environment=REDIS_HOST=127.0.0.1
Environment=REDIS_PORT=6379
Environment=FORTIADC_SYSLOG_HOST=0.0.0.0
Environment=FORTIADC_SYSLOG_PORT=514
ExecStart=/root/LAPNet/Fraud-monitor/venv/bin/python -m src.ingestion.fortiadc_streamer
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
