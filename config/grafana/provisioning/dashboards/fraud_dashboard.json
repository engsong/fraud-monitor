      },
      "id": 12,
      "title": "🎯 Suspicious Beneficiaries & Potential Mule Accounts (Fan-In Analysis)",
      "type": "table",
      "datasource": "PostgreSQL-FraudDB",
      "description": "Monitors destination accounts receiving inbound transfers from multiple unique senders or abnormal inbound volume.",
      "targets": [
        {
          "datasource": "PostgreSQL-FraudDB",
          "format": "table",
          "rawSql": "SELECT dest_bank AS \"Dest Bank\", CASE WHEN length(dest_account) > 28 THEN substring(dest_account from 1 for 16) || '...' || substring(dest_account from length(dest_account)-6) ELSE dest_account END AS \"Beneficiary / Mule Account\", count(DISTINCT source_account) AS \"Unique Senders (Fan-In)\", count(*) AS \"Inbound Deposits\", MAX(currency) AS \"Ccy\", to_char(sum(amount), 'FM999,999,999,990.00') AS \"Total Inflow Volume\", to_char(MAX(timestamp), 'HH24:MI:SS') AS \"Last Active (UTC)\" FROM fraud_monitoring.transactions WHERE $__timeFilter(timestamp) GROUP BY dest_bank, dest_account HAVING count(DISTINCT source_account) >= 2 OR count(*) >= 3 ORDER BY \"Unique Senders (Fan-In)\" DESC, \"Inbound Deposits\" DESC LIMIT 15;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Dest Bank" },
            "properties": [
              { "id": "custom.width", "value": 90 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Beneficiary / Mule Account" },
            "properties": [
              { "id": "custom.width", "value": 240 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Unique Senders (Fan-In)" },
            "properties": [
              { "id": "custom.width", "value": 150 },
