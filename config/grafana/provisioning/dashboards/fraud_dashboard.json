                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "text", "value": null },
                    { "color": "#FF9900", "value": 3 },
                    { "color": "#E02F44", "value": 6 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Inbound Deposits" },
            "properties": [
              { "id": "custom.width", "value": 130 },
              {
