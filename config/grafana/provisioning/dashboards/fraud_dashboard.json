      "id": 13,
      "title": "⚡ Alert Types (Sender vs Mule/Receiver)",
      "type": "piechart",
      "datasource": "PostgreSQL-FraudDB",
      "description": "Distribution of triggered alerts categorized by Sender Velocity vs Mule Account vs Policy violations.",
      "targets": [
        {
          "datasource": "PostgreSQL-FraudDB",
          "format": "table",
          "rawSql": "SELECT CASE WHEN reason LIKE '%Mule%' OR reason LIKE '%Inflow%' OR reason LIKE '%Beneficiary%' THEN 'Receiver / Mule Alert' WHEN reason LIKE '%Velocity%' THEN 'Sender High Velocity' WHEN reason LIKE '%Large Transfer%' THEN 'High-Value Transfer' WHEN reason LIKE '%Off-Hours%' THEN 'Off-Hours Activity' WHEN reason LIKE '%Probing%' THEN 'Micro-Probing Attack' ELSE 'Other Policy Violation' END AS \"Alert Category\", count(*) AS \"Count\" FROM fraud_monitoring.fraud_alerts, unnest(reasons) AS reason WHERE $__timeFilter(timestamp) GROUP BY 1 ORDER BY \"Count\" DESC;",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": true
        },
        "pieType": "pie",
        "tooltip": {
          "mode": "single"
