# ==============================================================================
# FRAUD MONITORING ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Engine Selection ('postgres', 'clickhouse', or 'both')
DB_ENGINE=postgres

# PostgreSQL Configuration (lapnet_eslip_db on 127.0.0.1:5432)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=lev
POSTGRES_PASSWORD=LEV@2026
POSTGRES_DB=lapnet_eslip_db
POSTGRES_SCHEMA=fraud_monitoring

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=switching-raw-logs
KAFKA_TOPIC_NORMALIZED=switching-normalized-tx

# Redis Configuration (In-Memory State & Velocity)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ClickHouse Configuration (Secondary)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=lapnet2026
CLICKHOUSE_DB=fraud_monitoring

# Alerting Thresholds
RISK_ALERT_THRESHOLD=80
MAX_VELOCITY_1MIN=5
MAX_SINGLE_AMOUNT=50000000

# Multi-Currency Large Transfer Limits (Triggers "Large Transfer" Rule)
MAX_AMOUNT_LAK=50000000
MAX_AMOUNT_THB=80000
MAX_AMOUNT_USD=2500
MAX_AMOUNT_CNY=15000

# Multi-Currency Off-Hours Transfer Limits (01:00 - 04:30 AM UTC)
OFF_HOURS_LAK=10000000
OFF_HOURS_THB=15000
OFF_HOURS_USD=500
OFF_HOURS_CNY=3000

# Multi-Currency Micro-Probing Limits (Rapid card/account testing)
PROBING_LAK=10000
PROBING_THB=20
PROBING_USD=1.0
PROBING_CNY=5.0

# Multi-Currency Exchange Rates to LAK (Used by AI Machine Learning for scale normalization)
RATE_THB_TO_LAK=650
RATE_USD_TO_LAK=22000
RATE_CNY_TO_LAK=3100

# Telegram Bot Alert Configuration
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
TELEGRAM_ENABLED=false

